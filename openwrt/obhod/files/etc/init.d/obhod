#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

# rc.common sources this file before procd.sh takes FD 1000. Enter the apply
# lease first, in the same order as LuCI, then let control call the native init
# methods internally. In particular, an external stop needs control's final
# post-kill DNS drain; stop_service alone cannot drain a starting worker.
case "${action:-}" in
	start|stop|restart|reload|boot|shutdown)
		[ "${OBHOD_CONTROL:-}" = 1 ] || exec /usr/libexec/obhod/control service "$action"
		;;
esac

start_service() {
	if [ "$(uci -q get obhod.main.enabled)" != 1 ]; then
		/usr/libexec/obhod/dns restore
		return 0
	fi
	/usr/libexec/obhod/control prepare || { /usr/libexec/obhod/dns restore-if-unready; return 1; }
	for pool in direct proxy bootstrap filter; do
		file="/var/run/obhod/dns-pool-$pool.json"
		[ -s "$file" ] || continue
		procd_open_instance "dns-pool-$pool"
		procd_set_param command /usr/bin/ucode /usr/libexec/obhod/dns-pool.uc "$file"
		procd_set_param respawn 3600 2 5
		procd_set_param term_timeout 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	done
	procd_open_instance main
	procd_set_param command /usr/libexec/obhod/run
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/obhod/settings.json
	procd_close_instance
}

stop_service() {
	# rc.common passes stop arguments to procd as instance names; use an
	# environment flag only for the synchronous control replacement path.
	if [ "$OBHOD_DNS_HANDOFF" = 1 ]; then
		/usr/libexec/obhod/dns restore-unless-held
	else
		/usr/libexec/obhod/dns restore
	fi
}

restart() {
	/usr/libexec/obhod/control start
}

reload_service() {
	restart
}

service_triggers() {
	# As in Podkop's WAN monitoring, debounce network events. A healthy core
	# handles address changes itself; recover only restarts a missing/broken one.
	PROCD_RELOAD_DELAY=2000
	procd_add_reload_trigger obhod firewall
	config_load network
	config_foreach obhod_network_trigger interface
}

obhod_network_trigger() {
	# procd's .* matcher is prefix-only; a suffix .up would also match down.
	# Pass the logical interface and check its current up state in recover.
	[ "$1" = loopback ] || procd_add_interface_trigger 'interface.*' "$1" /usr/libexec/obhod/control recover "$1"
}
