#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Modify only the selected dnsmasq instance's server/noresolv, with a durable backup.
umask 077
set -f
. /usr/share/libubox/jshn.sh
BACKUP=/etc/obhod/dns-backup.json
[ "$1" != restore ] || [ -f "$BACKUP" ] || exit 0
mkdir -p /var/run/obhod /var/lock
# The shell retains the open file description, including across helper exits.
# A killed worker cannot leave a stale mkdir lock behind.
exec 8>/var/lock/obhod-dns.guard || exit 1
ucode -e 'import { fdopen } from "fs"; let lease = fdopen(8, "a"); if (!lease || !lease.lock("x")) exit(1);' || exit 1
WORK=$(mktemp -d /var/run/obhod/dns.XXXXXX) || exit 1
staged=
trap 'rm -f "$staged" "$WORK/original" "$WORK/obhod_dns_work" "$WORK/.uci/obhod_dns_work"; rmdir "$WORK/.uci" "$WORK" 2>/dev/null' EXIT
mkdir "$WORK/.uci"
# A distinct package name prevents libuci from reading /tmp/.uci/dhcp deltas.
# Commit this fresh snapshot, never another LuCI session's pending changes.
cp /etc/config/dhcp "$WORK/original" && cp "$WORK/original" "$WORK/obhod_dns_work" || exit 1
uci() { command uci -c "$WORK" -t "$WORK/.uci" "$@"; }
commit_dns() {
	uci commit obhod_dns_work || return 1
	staged=$(mktemp /etc/config/.dhcp.obhod.XXXXXX) || return 1
	ucode /usr/libexec/obhod/dns-commit.uc "$WORK/original" "$WORK/obhod_dns_work" "$staged" "$1"
}

append_server() { json_add_string '' "$1"; }
reload_dns() { (exec 8>&-; /etc/init.d/dnsmasq restart >/dev/null 2>&1); }
save_backup() { json_dump > "$BACKUP.tmp" && mv "$BACKUP.tmp" "$BACKUP"; }
mark_applied() {
	json_load "$(cat "$BACKUP")" && json_add_string phase applied && save_backup
}
conflict() {
	printf '%s\n' 'Настройки DNS изменены извне; backup сохранён в /etc/obhod/dns-backup.json. Проверьте server/noresolv/cachesize и повторите restore.' >&2
	logger -t obhod 'Конфликт DNS: сохранённая копия оставлена в /etc/obhod/dns-backup.json.'
	return 1
}
load_backup() {
	old_cache=; manage_cache=0
	json_load "$(cat "$BACKUP")" || return 1
	json_get_var section section
	json_get_var old_noresolv noresolv
	json_get_values servers servers
	json_get_var old_cache cachesize
	json_get_var manage_cache manageCache || manage_cache=0
	json_get_var phase phase || phase=legacy
	case "$section" in ''|*[!a-zA-Z0-9_]*) return 1;; esac
	json_get_type kind servers; [ "$kind" = array ] || return 1
	json_get_type kind noresolv; [ "$kind" = string ] || return 1
	case "$phase" in prepared|applying|applied|restoring|legacy) ;; *) return 1;; esac
	return 0
}
has_owned() {
	for value in $(uci -q get "obhod_dns_work.$section.server"); do
		[ "$value" != '127.0.0.1#1053' ] || return 0
	done
	return 1
}
is_restored() {
	[ "$phase" = restoring ] || return 1
	json_get_var restored_servers restoreServers || return 1
	json_get_var restored_noresolv restoreNoresolv || return 1
	json_get_var restored_cache restoreCache || return 1
	[ "$(uci -q get "obhod_dns_work.$section.server")" = "$restored_servers" ] &&
	[ "$(uci -q get "obhod_dns_work.$section.noresolv")" = "$restored_noresolv" ] &&
	[ "$(uci -q get "obhod_dns_work.$section.cachesize")" = "$restored_cache" ]
}
is_original() {
	[ "$(uci -q get "obhod_dns_work.$section.server")" = "$servers" ] &&
	[ "$(uci -q get "obhod_dns_work.$section.noresolv")" = "$old_noresolv" ] &&
	{ [ "$manage_cache" != 1 ] || [ "$(uci -q get "obhod_dns_work.$section.cachesize")" = "$old_cache" ]; }
}
is_applied() {
	[ "$(uci -q get "obhod_dns_work.$section.server")" = '127.0.0.1#1053' ] &&
	[ "$(uci -q get "obhod_dns_work.$section.noresolv")" = 1 ] &&
	{ [ "$manage_cache" != 1 ] || [ "$(uci -q get "obhod_dns_work.$section.cachesize")" = 0 ]; }
}

case "$1" in
	apply)
		if [ -f "$BACKUP" ]; then
			load_backup || { conflict; exit 1; }
			if [ "$phase" = prepared ]; then
				# The commit helper records intent only after checking the UCI snapshot.
				# An identical listener added externally is not ours to claim/remove.
				has_owned && { conflict; exit 1; }
				rm -f "$BACKUP" || exit 1
			elif is_restored; then
				reload_dns && rm -f "$BACKUP" || exit 1
			elif is_applied && [ "$phase" != restoring ]; then
				[ "$phase" = applied ] || [ "$phase" = legacy ] || { reload_dns && mark_applied; exit $?; }
				exit 0
			else
				is_original || { conflict; exit 1; }
				rm -f "$BACKUP" || exit 1
			fi
		fi
		instances=$(uci -q -X show obhod_dns_work | sed -n 's/^obhod_dns_work\.\([a-zA-Z0-9_]*\)=dnsmasq$/\1/p')
		set -- $instances
		[ "$#" -eq 1 ] || { logger -t obhod 'Для управления DNS нужен один экземпляр dnsmasq. Настройте DNS вручную.'; exit 1; }
		section=$1
		has_owned && { conflict; exit 1; }
		old_noresolv=$(uci -q get "obhod_dns_work.$section.noresolv")
		old_cache=$(uci -q get "obhod_dns_work.$section.cachesize")
		manage_cache=1
		json_init
		json_add_string phase prepared
		json_add_string section "$section"
		json_add_string noresolv "$old_noresolv"
		json_add_string cachesize "$old_cache"
		json_add_boolean manageCache "$manage_cache"
		json_add_array servers
		# dnsmasq server values cannot contain whitespace; do not eval UCI output.
		for server in $(uci -q get "obhod_dns_work.$section.server"); do append_server "$server"; done
		json_close_array
		save_backup || exit 1
		uci -q delete "obhod_dns_work.$section.server" || [ -z "$(uci -q get "obhod_dns_work.$section.server")" ] || exit 1
		[ "$manage_cache" != 1 ] || uci set "obhod_dns_work.$section.cachesize=0" || exit 1
		uci add_list "obhod_dns_work.$section.server=127.0.0.1#1053" && uci set "obhod_dns_work.$section.noresolv=1" && commit_dns apply && reload_dns && mark_applied && exit 0
		# The worker's EXIT cleanup restores the durable backup on failure.
		exit 1
		;;
	restore)
		[ -f "$BACKUP" ] || exit 0
		load_backup || { conflict; exit 1; }
		if [ "$phase" = prepared ]; then
			has_owned && { conflict; exit 1; }
			rm -f "$BACKUP"; exit $?
		fi
		if is_restored; then reload_dns && rm -f "$BACKUP"; exit $?; fi
		# Restore only values we still own. A changed cache size must not leave
		# dnsmasq forwarding to our now-stopped listener, or overwrite that edit.
		[ "$manage_cache" != 1 ] || [ "$(uci -q get "obhod_dns_work.$section.cachesize")" = 0 ] || manage_cache=0
		if is_original; then reload_dns && rm -f "$BACKUP"; exit $?; fi
		current_servers=$(uci -q get "obhod_dns_work.$section.server")
		owned=0; additions=
		for server in $current_servers; do
			if [ "$server" = '127.0.0.1#1053' ]; then owned=1; else additions="$additions $server"; fi
		done
		if [ "$owned" != 1 ]; then
			conflict
			exit 1
		fi
		uci -q delete "obhod_dns_work.$section.server" || exit 1
		for server in $servers $additions; do uci add_list "obhod_dns_work.$section.server=$server" || exit 1; done
		if [ "$(uci -q get "obhod_dns_work.$section.noresolv")" = 1 ]; then
			if [ -n "$old_noresolv" ]; then uci set "obhod_dns_work.$section.noresolv=$old_noresolv"; else uci -q delete "obhod_dns_work.$section.noresolv"; fi || exit 1
		fi
		if [ "$manage_cache" = 1 ]; then
			if [ -n "$old_cache" ]; then uci set "obhod_dns_work.$section.cachesize=$old_cache"; else uci -q delete "obhod_dns_work.$section.cachesize"; fi || exit 1
		fi
		# Keep the exact restore result, including foreign additions, across a
		# failed restart or a crash after rename. Retry never guesses ownership.
		json_add_string restoreServers "$(uci -q get "obhod_dns_work.$section.server")"
		json_add_string restoreNoresolv "$(uci -q get "obhod_dns_work.$section.noresolv")"
		json_add_string restoreCache "$(uci -q get "obhod_dns_work.$section.cachesize")"
		save_backup && commit_dns restore || exit 1
		reload_dns && rm -f "$BACKUP"
		;;
	*) exit 2 ;;
esac
