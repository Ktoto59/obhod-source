#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
umask 077
RUN=/var/run/obhod
child=
monitor=
log_pid=
rm -f "$RUN/ready"
printf '%s\n' "$$" > "$RUN/run-pid"
cleanup() {
	rm -f "$RUN/ready"
	[ -z "$monitor" ] || kill "$monitor" 2>/dev/null
	/usr/libexec/obhod/dns restore-unless-held
	[ -z "$child" ] || { kill "$child" 2>/dev/null; wait "$child" 2>/dev/null; }
	[ -z "$log_pid" ] || wait "$log_pid" 2>/dev/null
	[ -z "$monitor" ] || wait "$monitor" 2>/dev/null
	rm -f "$RUN/log.pipe"
	[ "$(cat "$RUN/run-pid" 2>/dev/null)" != "$$" ] || rm -f "$RUN/run-pid"
}
trap cleanup EXIT
trap 'exit 143' TERM INT

# Establish crash recovery before launching the core, including SIGKILL/OOM.
if [ "$(jsonfilter -i /etc/obhod/settings.json -e '@.options.strictDns')" = true ]; then
	/usr/libexec/obhod/dns hold || exit 1
fi
/usr/libexec/obhod/dns guard "$$" || exit 1
if [ "$(jsonfilter -i /etc/obhod/settings.json -e '@.options.manageDns')" != false ]; then
	/usr/libexec/obhod/dns hold && /usr/libexec/obhod/dns apply "$$" || {
		printf '%s\n' 'Не удалось переключить dnsmasq на шифрованный DNS Обхода.' > "$RUN/error"
		exit 1
	}
fi
rm -f "$RUN/log.pipe" "$RUN/telemetry.json"
mkfifo -m 600 "$RUN/log.pipe" || exit 1
ucode /usr/libexec/obhod/log.uc < "$RUN/log.pipe" &
log_pid=$!
attempt=0
ports=$(jsonfilter -i "$RUN/bootstrap.json" -e '@.inbounds[*].listen_port')
while [ "$attempt" -lt 5 ]; do
	listening=1
	for port in 1155 $ports; do
		hex=$(printf '%04X' "$port")
		grep -q "0100007F:$hex .* 0A " /proc/net/tcp || listening=0
	done
	[ "$listening" = 0 ] || break
	sleep 1
	attempt=$((attempt + 1))
done
if [ "${listening:-0}" != 1 ]; then
	printf '%s\n' 'Не удалось запустить локальные слушатели Bootstrap DoH.' > "$RUN/error"
	exit 1
fi
/usr/bin/sing-box run -c "$RUN/config.json" > "$RUN/log.pipe" 2>&1 &
child=$!
attempt=0
startup_wait=10
# The experimental core bounds cold URLTest rule downloads to 16 seconds.
if jsonfilter -i "$RUN/config.json" -e '@.route.rule_set[*].obhod_try_group' | grep -qx true; then
	startup_wait=20
fi
while [ "$attempt" -lt "$startup_wait" ]; do
	sleep 1
	kill -0 "$child" 2>/dev/null || exit 1
	# Announce readiness only after the encrypted DNS path can accept queries.
	listening=1
	grep -q '0100007F:041D .* 0A ' /proc/net/tcp || listening=0
	for pool in direct proxy bootstrap filter; do
		[ -s "$RUN/dns-pool-$pool.json" ] || continue
		case "$pool" in direct) port=0481;; proxy) port=0482;; bootstrap) port=0483;; filter) port=0484;; esac
		grep -q "0100007F:$port .* 0A " /proc/net/tcp || listening=0
	done
	[ "$listening" = 1 ] && break
	attempt=$((attempt + 1))
done
[ "$attempt" -lt "$startup_wait" ] || exit 1
/usr/libexec/obhod/dns ready "$$" || {
	printf '%s\n' 'Не удалось настроить DNS. Проверьте dnsmasq и сохранённую копию DNS.' > "$RUN/error"
	exit 1
}
/usr/libexec/obhod/monitor "$child" &
monitor=$!
wait "$child"
result=$?
exit "$result"
