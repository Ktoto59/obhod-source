#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
umask 077
. /usr/share/libubox/jshn.sh

STATE=/etc/obhod/settings.json
RUN=/var/run/obhod
operation() { ucode /usr/libexec/obhod/operation.uc "$@"; }

error() {
	printf '%s\n' "$1" > "$RUN/error"
	logger -t obhod "$1"
	return 1
}

prepare() {
	mkdir -p "$RUN" /etc/obhod
	chmod 700 "$RUN" /etc/obhod
	rm -f "$RUN/ready" "$RUN/error"
	[ -s "$STATE" ] || { error 'Сначала добавьте подключение в LuCI.'; return 1; }
	# 1.12 is required for modern DNS, WireGuard endpoints and AnyTLS.
	version=$(/usr/bin/sing-box version 2>/dev/null | head -n 1 | sed -n 's/.*version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p')
	set -- $version
	[ "$#" -eq 2 ] && { [ "$1" -gt 1 ] || { [ "$1" -eq 1 ] && [ "$2" -ge 12 ]; }; } || {
		error 'Требуется sing-box или sing-box-tiny версии 1.12 или новее. Выберите протоколы в LuCI.'; return 1;
	}
	# Do not create competing transparent routing tables alongside another manager.
	for other in sing-box podkop passwall passwall2 homeproxy; do
		if ubus call service list "{\"name\":\"$other\"}" 2>/dev/null | jsonfilter -e '@.*.instances.*.running' | grep -q true; then
			error 'Остановите другую службу прокси перед запуском Обхода.'; return 1
		fi
	done
	if [ ! -s "$RUN/controller-secret" ]; then
		cat /proc/sys/kernel/random/uuid > "$RUN/controller-secret" || return 1
		chmod 600 "$RUN/controller-secret"
	fi
	ucode /usr/libexec/obhod/prepare.uc || { error 'Не удалось подготовить конфигурацию службы.'; return 1; }
	# 1.13 introduced NFQUEUE before the native address-set filter. Require the
	# fixed ordering; older 1.12 cores select destinations in nftables already.
	if { [ "$1" -gt 1 ] || [ "$2" -ge 13 ]; } && ! /usr/bin/sing-box obhod-capabilities 2>/dev/null | grep -qx kernel-route-set-v1; then
		/usr/libexec/obhod/core-upgrade-required > "$RUN/core-upgrade-log" 2>&1 || {
			error 'Не удалось установить обязательное ядро .4. Профиль сохранён; проверьте место, интернет и журнал core-upgrade-log.'; return 1;
		}
	fi
	ucode /usr/libexec/obhod/kernel-route.uc "$RUN/config.json" || {
		error 'Не удалось подготовить отбор трафика в nftables.'; return 1;
	}
	if /usr/bin/sing-box obhod-capabilities 2>/dev/null | grep -qx dns-pool-v1; then
		ucode /usr/libexec/obhod/native-dns.uc || { error 'Не удалось подготовить встроенную группу DNS.'; return 1; }
	fi
	ucode /usr/libexec/obhod/dns-pool-config.uc || { error 'Не удалось подготовить группу DNS. Проверьте список серверов в LuCI.'; return 1; }
	for pool in direct proxy bootstrap; do
		file="$RUN/dns-pool-$pool.json"
		[ -s "$file" ] || continue
		ucode /usr/libexec/obhod/dns-pool.uc "$file" --check >/dev/null 2>&1 || {
			error 'Не удалось запустить группу DNS. Проверьте пакет ucode-mod-socket и настройки.'; return 1;
		}
	done
	/usr/bin/sing-box check -c "$RUN/config.json" >/dev/null 2>&1 || {
		error 'Ядро отклонило конфигурацию. Проверьте версию и поддерживаемые протоколы.'; return 1;
	}
	# An unchanged save is safe only for the sources which prepared this run.
	# App updates and external settings edits must still take the restart path.
	set -- "$STATE" "$RUN/config.json" /usr/bin/sing-box /usr/share/obhod/version \
        /usr/libexec/obhod/* /etc/init.d/obhod
	# The backend can also be installed without the optional LuCI package.
	[ ! -f /www/luci-static/resources/obhod/core.js ] || set -- "$@" /www/luci-static/resources/obhod/core.js
	sha256sum "$@" > "$RUN/prepared.sha.tmp" && mv "$RUN/prepared.sha.tmp" "$RUN/prepared.sha"
}

ready() {
	count=0
	while [ "$count" -lt 15 ]; do
		[ -f "$RUN/ready" ] && return 0
		sleep 1
		count=$((count + 1))
	done
	return 1
}

set_enabled() {
	uci set "obhod.main.enabled=$1" && uci commit obhod
}

stop_failed() {
	# procd can reject stop while the previous, ready worker is still alive.
	# Return its DNS dependency to the running configuration. Do not point DNS
	# at a listener which actually exited, or restart/replace the core here.
	if [ "$dns_was_managed" = 1 ] && [ -f "$RUN/ready" ] && operation alive "$pid"; then
		/usr/libexec/obhod/dns apply || { error 'Остановка не завершена; не удалось повторно применить DNS. Служба работает, проверьте DNS и повторите остановку.'; return 1; }
		# cleanup removes ready before restoring DNS. If it won the race with
		# apply, remove our newly installed dependency as well. A ready respawn
		# still needs its DNS and must be left intact.
		if [ ! -f "$RUN/ready" ] || ! operation alive "$(cat "$RUN/run-pid" 2>/dev/null)"; then
			/usr/libexec/obhod/dns restore || { error 'Служба завершилась; не удалось восстановить DNS. Повторите остановку после проверки DNS.'; return 1; }
		fi
	fi
	error 'Не удалось остановить службу. Состояние включения сохранено; повторите остановку.'
}

stop_and_wait() {
	# Do not turn off the listener while dnsmasq still depends on it. A failed
	# transaction must leave the running service available for a safe retry.
	dns_was_managed=0
	if [ -f /etc/obhod/dns-backup.json ] && [ "$(jsonfilter -i "$STATE" -e '@.options.manageDns' 2>/dev/null)" = true ]; then dns_was_managed=1; fi
	/usr/libexec/obhod/dns restore || { error 'Не удалось восстановить DNS; служба оставлена работающей. Повторите остановку после проверки DNS.'; return 1; }
	pid=$(cat "$RUN/run-pid" 2>/dev/null)
	[ -n "$pid" ] || pid=$(ubus call service list '{"name":"obhod"}' 2>/dev/null | jsonfilter -e '@.obhod.instances.main.pid')
	/etc/init.d/obhod stop >/dev/null 2>&1 || { stop_failed; return 1; }
	case "$pid" in ''|*[!0-9]*) return 0 ;; esac
	count=0
	while kill -0 "$pid" 2>/dev/null; do
		[ "$count" -lt 20 ] || { stop_failed; return 1; }
		sleep 1; count=$((count + 1))
	done
}

recover() {
	# Event-driven recovery, serialized with LuCI/apply; never enable a service
	# the user stopped. A healthy service keeps all existing connections.
	[ "$(uci -q get obhod.main.enabled)" = 1 ] || return 0
	if [ -n "$1" ]; then
		case "$1" in *[!a-zA-Z0-9_-]*) return 1;; esac
		[ "$(ubus call "network.interface.$1" status 2>/dev/null | jsonfilter -e '@.up')" = true ] || return 0
	fi
	token=$(operation acquire apply '' "$$") || return 0
	trap 'operation release apply "$token" "$$"' EXIT
	exec 9>/var/lock/obhod-apply.lock/lease || return 1
	operation hold apply "$token" "$$" || return 1
	[ "$(uci -q get obhod.main.enabled)" = 1 ] || return 0
	pid=$(cat "$RUN/run-pid" 2>/dev/null)
	case "$pid" in ''|*[!0-9]*) pid= ;; esac
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		# procd may still be starting it (including loading cached rule sets).
		[ -f "$RUN/ready" ] || return 0
		if grep -q '0100007F:041D .* 0A ' /proc/net/tcp &&
			nft list set inet sing-box inet4_route_address_set >/dev/null 2>&1; then
			return 0
		fi
	fi
	logger -t obhod 'Сеть доступна; восстанавливаем службу Обхода.'
	if ! "$0" start; then
		# A transient outage must retain the user's enabled intent for the next
		# link-up event, even when this particular recovery attempt failed.
		set_enabled 1
		return 1
	fi
}

case "$1" in
	prepare) prepare ;;
	ready) ready ;;
	recover) recover "$2" ;;
	start)
		stop_and_wait || exit 1
		set_enabled 1 || exit 1
		/etc/init.d/obhod start >/dev/null 2>&1 && ready && exit 0
		stop_and_wait && set_enabled 0
		exit 1
		;;
	stop)
		stop_and_wait && set_enabled 0
		;;
	*) exit 2 ;;
esac
