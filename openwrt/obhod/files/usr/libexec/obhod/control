#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
umask 077
. /usr/share/libubox/jshn.sh

STATE=/etc/obhod/settings.json
RUN=/var/run/obhod
operation() { ucode /usr/libexec/obhod/operation.uc "$@"; }

error() {
	printf '%s\n' "$1" > "$RUN/error"
	logger -t obhod "$1"
	return 1
}

prepare() {
	mkdir -p "$RUN" /etc/obhod
	chmod 700 "$RUN" /etc/obhod
	rm -f "$RUN/ready" "$RUN/error" "$RUN/bootstrap-error"
	[ -s "$STATE" ] || { error 'Сначала добавьте подключение в LuCI.'; return 1; }
	# 1.12 is required for modern DNS, WireGuard endpoints and AnyTLS.
	version=$(/usr/bin/sing-box version 2>/dev/null | head -n 1 | sed -n 's/.*version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p')
	set -- $version
	[ "$#" -eq 2 ] && { [ "$1" -gt 1 ] || { [ "$1" -eq 1 ] && [ "$2" -ge 12 ]; }; } || {
		error 'Требуется sing-box или sing-box-tiny версии 1.12 или новее. Выберите протоколы в LuCI.'; return 1;
	}
	# Do not create competing transparent routing tables alongside another manager.
	for other in sing-box podkop passwall passwall2 homeproxy; do
		if ubus call service list "{\"name\":\"$other\"}" 2>/dev/null | jsonfilter -e '@.*.instances.*.running' | grep -q true; then
			error 'Остановите другую службу прокси перед запуском Обхода.'; return 1
		fi
	done
	if [ ! -s "$RUN/controller-secret" ]; then
		cat /proc/sys/kernel/random/uuid > "$RUN/controller-secret" || return 1
		chmod 600 "$RUN/controller-secret"
	fi
	# 1.13 introduced NFQUEUE before the native address-set filter. Require the
	# fixed ordering; older 1.12 cores select destinations in nftables already.
	if { [ "$1" -gt 1 ] || [ "$2" -ge 13 ]; } && ! /usr/bin/sing-box obhod-capabilities 2>/dev/null | grep -qx kernel-route-set-v1; then
		error 'Для маршрутизации в sing-box 1.13 и новее выберите совместимое ядро Обхода на вкладке «Протоколы».'; return 1
	fi
	if ! reason=$(/usr/libexec/obhod/prepare-config prepare "$STATE" "$RUN"); then
		error "$reason"; return 1
	fi
	ucode -e 'import * as socket from "socket";' >/dev/null 2>&1 || {
		error 'Для Bootstrap DoH требуется пакет ucode-mod-socket.'; return 1;
	}
	for pool in direct proxy bootstrap filter; do
		file="$RUN/dns-pool-$pool.json"
		[ -s "$file" ] || continue
		ucode /usr/libexec/obhod/dns-pool.uc "$file" --check >/dev/null 2>&1 || {
			error 'Не удалось запустить группу DNS. Проверьте пакет ucode-mod-socket и настройки.'; return 1;
		}
	done
	# An unchanged save is safe only for the sources which prepared this run.
	# App updates and external settings edits must still take the restart path.
	set -- "$STATE" "$RUN/config.json" "$RUN/bootstrap.json" /usr/bin/sing-box /usr/share/obhod/version \
        /usr/libexec/obhod/* /etc/init.d/obhod
	# The backend can also be installed without the optional LuCI package.
	[ ! -f /www/luci-static/resources/obhod/core.js ] || set -- "$@" /www/luci-static/resources/obhod/core.js
	sha256sum "$@" > "$RUN/prepared.sha.tmp" && mv "$RUN/prepared.sha.tmp" "$RUN/prepared.sha"
}

ready() {
	count=0
	while [ "$count" -lt 25 ]; do
		[ -f "$RUN/ready" ] && return 0
		sleep 1
		count=$((count + 1))
	done
	return 1
}

set_enabled() {
	uci set "obhod.main.enabled=$1" && uci commit obhod
}

stop_failed() {
	# procd can reject stop while the previous, ready worker is still alive.
	# Return its DNS dependency to the running configuration. Do not point DNS
	# at a listener which actually exited, or restart/replace the core here.
	if [ -f "$RUN/ready" ] && operation alive "$pid" &&
		[ "$(jsonfilter -i "$STATE" -e '@.options.strictDns')" = true ]; then
		/usr/libexec/obhod/dns guard "$pid" || { error 'Не удалось восстановить строгую защиту DNS после отмены остановки.'; return 1; }
	fi
	if [ "$manage_dns" = 1 ] && [ -f "$RUN/ready" ] && operation alive "$pid"; then
		/usr/libexec/obhod/dns apply || { error 'Остановка не завершена; не удалось повторно применить DNS. Служба работает, проверьте DNS и повторите остановку.'; return 1; }
		# cleanup removes ready before restoring DNS. If it won the race with
		# apply, remove our newly installed dependency as well. A ready respawn
		# still needs its DNS and must be left intact.
		if [ ! -f "$RUN/ready" ] || ! operation alive "$(cat "$RUN/run-pid" 2>/dev/null)"; then
			/usr/libexec/obhod/dns restore || { error 'Служба завершилась; не удалось восстановить DNS. Повторите остановку после проверки DNS.'; return 1; }
		fi
	fi
	error 'Не удалось остановить службу. Состояние включения сохранено; повторите остановку.'
}

stop_and_wait() {
	preserve_dns=${1:-0}
	# Explicit stop restores DNS before turning off its listener. A replacement
	# keeps that dependency through a bounded watchdog grace instead.
	# A starting apply may publish its first backup while restore waits on FD 8.
	# Use the configured policy for failed-stop recovery, not an unlocked stat.
	manage_dns=1
	[ "$(jsonfilter -i "$STATE" -e '@.options.manageDns' 2>/dev/null)" != false ] || manage_dns=0
	if [ "$preserve_dns" = 1 ]; then dns_action=hold; else dns_action=restore; fi
	/usr/libexec/obhod/dns "$dns_action" || { error 'Не удалось восстановить DNS; служба оставлена работающей. Повторите остановку после проверки DNS.'; return 1; }
	pid=$(cat "$RUN/run-pid" 2>/dev/null)
	[ -n "$pid" ] || pid=$(ubus call service list '{"name":"obhod"}' 2>/dev/null | jsonfilter -e '@.obhod.instances.main.pid')
	OBHOD_CONTROL=1 OBHOD_DNS_HANDOFF="$preserve_dns" /etc/init.d/obhod stop >/dev/null 2>&1 || { stop_failed; return 1; }
	case "$pid" in ''|*[!0-9]*) pid= ;; esac
	count=0
	while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; do
		[ "$count" -lt 20 ] || { stop_failed; return 1; }
		sleep 1; count=$((count + 1))
	done
	# SIGKILL can leave a DNS child alive after the run PID exits. Drain its
	# transaction under FD 8 before reporting stop success or clearing enabled.
	/usr/libexec/obhod/dns "$dns_action" || { error 'Служба остановлена, но не удалось окончательно восстановить DNS. Проверьте DNS и повторите остановку.'; return 1; }
}

recover() {
	# Event-driven recovery, serialized with LuCI/apply; never enable a service
	# the user stopped. A healthy service keeps all existing connections.
	[ "$(uci -q get obhod.main.enabled)" = 1 ] || return 0
	if [ -n "$1" ]; then
		case "$1" in *[!a-zA-Z0-9_-]*) return 1;; esac
		[ "$(ubus call "network.interface.$1" status 2>/dev/null | jsonfilter -e '@.up')" = true ] || return 0
	fi
	token=$(operation acquire apply '' "$$") || return 0
	trap 'operation release apply "$token" "$$"' EXIT
	exec 9>/var/lock/obhod-apply.lock/lease || return 1
	operation hold apply "$token" "$$" || return 1
	[ "$(uci -q get obhod.main.enabled)" = 1 ] || return 0
	pid=$(cat "$RUN/run-pid" 2>/dev/null)
	case "$pid" in ''|*[!0-9]*) pid= ;; esac
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		# procd may still be starting it (including loading cached rule sets).
		[ -f "$RUN/ready" ] || return 0
		if grep -q '0100007F:041D .* 0A ' /proc/net/tcp &&
			{ nft list set inet sing-box inet4_route_address_set >/dev/null 2>&1 || nft list set inet sing-box obhod_selected_v4 >/dev/null 2>&1; }; then
			if [ "$(jsonfilter -i "$STATE" -e '@.options.strictDns')" = true ] &&
				! nft list table inet obhod_dns_guard >/dev/null 2>&1; then
				/usr/libexec/obhod/dns guard "$pid" || return 1
			fi
			return 0
		fi
	fi
	logger -t obhod 'Сеть доступна; восстанавливаем службу Обхода.'
	if ! "$0" start; then
		# A transient outage must retain the user's enabled intent for the next
		# link-up event, even when this particular recovery attempt failed.
		set_enabled 1
		return 1
	fi
}

dns_watch() {
	# 45 seconds covers procd's five-second respawn delay and listener startup.
	# A healthy worker renews this grace; failed respawn loops cannot renew it.
	missing=0
	while :; do
		sleep 1
		/usr/libexec/obhod/dns watch-tick "$1"
		case "$?" in 0) missing=0;; 3) missing=$((missing + 1));; 4) return 0;; *) return 1;; esac
		if [ "$missing" -ge 45 ]; then
			/usr/libexec/obhod/dns watch-expire "$1"
			case "$?" in 0) missing=0;; 4) return 0;; *) sleep 5;; esac
		fi
	done
}

service() {
	case "$1" in start|stop|restart|reload|boot|shutdown) ;; *) return 2;; esac
	token=$(operation acquire apply '' "$$") || return 1
	trap 'operation release apply "$token" "$$"' EXIT
	exec 9>/var/lock/obhod-apply.lock/lease || return 1
	operation hold apply "$token" "$$" || return 1
	case "$1" in
		stop) "$0" stop ;;
		shutdown) stop_and_wait ;;
		boot)
			if [ "$(uci -q get obhod.main.enabled)" = 1 ]; then
				# Keep procd's respawn budget when WAN is late during boot.
				OBHOD_CONTROL=1 /etc/init.d/obhod start
			else /usr/libexec/obhod/dns restore; fi
			;;
		*) "$0" start ;;
	esac
}

case "$1" in
	service) service "$2" ;;
	dns-watch) dns_watch "$2" ;;
	prepare) prepare ;;
	ready) ready ;;
	recover) recover "$2" ;;
	start)
		start_enabled=$(uci -q get obhod.main.enabled)
		stop_and_wait 1 || exit 1
		set_enabled 1 || exit 1
		OBHOD_CONTROL=1 /etc/init.d/obhod start >/dev/null 2>&1 && ready && exit 0
		if [ -s "$RUN/bootstrap-error" ]; then
			# Keep managed DNS and strict rules while the enabled service recovers.
			error "$(cat "$RUN/bootstrap-error")"
			exit 3
		fi
		# Preserve the same bounded grace for an RPC rollback to the old profile.
		if stop_and_wait 1 && [ "$start_enabled" != 1 ]; then set_enabled 0; fi
		exit 1
		;;
	stop)
		stop_and_wait && set_enabled 0
		;;
	*) exit 2 ;;
esac
